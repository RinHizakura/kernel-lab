# Kconfig fragment: kdump (vng_runner -k). The running kernel kexec -p loads
# itself as the capture kernel, so one image needs both halves: load a crash
# kernel, and boot as one with /proc/vmcore. Merge with CONFIG_FRAGMENTS.
CONFIG_KEXEC=y
CONFIG_KEXEC_FILE=y
CONFIG_CRASH_DUMP=y
CONFIG_PROC_VMCORE=y
CONFIG_RELOCATABLE=y
# echo c > /proc/sysrq-trigger
CONFIG_MAGIC_SYSRQ=y
# qemu -device vmcoreinfo: the guest hands QEMU the vmcoreinfo address through fw_cfg
CONFIG_FW_CFG_SYSFS=y
# analysing the vmcore (crash, drgn) needs DWARF
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
