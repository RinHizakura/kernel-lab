# Kconfig fragment: what a kernel needs to boot under virtme-ng (vng_runner).
# This is virtme's required list (virtme/commands/configkernel.py
# _GENERIC_CONFIG); the root is 9p or virtiofs with an overlay on top, so
# those must be built in, not modules. Merge with CONFIG_FRAGMENTS.
# CONFIG_UEVENT_HELPER is not set
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_NET=y
CONFIG_NET_CORE=y
CONFIG_NETDEVICES=y
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_VIRTIO_NET=y
# CONFIG_CMDLINE_OVERRIDE is not set
CONFIG_BINFMT_SCRIPT=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_UNIX=y
# CONFIG_MODULE_SIG_FORCE is not set
CONFIG_DEVTMPFS=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_UNIX98_PTYS=y
CONFIG_EARLY_PRINTK=y
CONFIG_INOTIFY_USER=y
# virtio-scsi
CONFIG_BLOCK=y
CONFIG_SCSI_LOWLEVEL=y
CONFIG_SCSI=y
CONFIG_SCSI_VIRTIO=y
CONFIG_BLK_DEV_SD=y
# virtio-serial (vng's script I/O ports)
CONFIG_VIRTIO_CONSOLE=y
# watchdog
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_I6300ESB_WDT=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_OVERLAY_FS=y
# virtio-fs
CONFIG_DAX=y
CONFIG_FS_DAX=y
CONFIG_MEMORY_HOTPLUG=y
CONFIG_MEMORY_HOTREMOVE=y
CONFIG_ZONE_DEVICE=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
# vsock (vng --ssh / --exec)
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
