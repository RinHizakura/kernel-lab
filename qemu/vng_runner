#!/usr/bin/env bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib.sh
source "$SCRIPT_DIR/../lib.sh"   # log/die, arch_name

function usage() {
    cat <<EOF
Usage: ${0##*/} [-h] [-n] [-a ARCH] [-r KDIR] [-d DEVICE] [-k] [-- VNG_ARGS...]

Thin wrapper around vng (virtme-ng) that attaches extra QEMU devices and
auto-selects the locally built QEMU under install_<ARCH>/bin if present.

Options:
  -a ARCH     Target architecture passed to vng --arch (e.g. arm64, riscv64).
              Also selects install_<ARCH>/bin/qemu-system-* when available and,
              for a cross arch, boots the <ARCH>-rootfs next to this script
              (make_rootfs.sh builds it and keeps its modules in step with
              the kernel in KDIR).
  -r KDIR     Kernel tree or O= build dir to boot (default: the cwd).
  -d DEVICE   Attach a storage device. Supported:
                usb-storage   USB EHCI stick backed by KDIR/usb.img
                ufs           UFS host controller + LU backed by KDIR/ufs.img
              (disk images are auto-created with ext4 on first use)
  -k          Enable kdump testing: crashkernel=512M, 4G guest, vmcoreinfo, and
              kexec -p the booted kernel as dump-capture kernel at shell start
              (see kdump-shell.sh). Its initrd is KDIR/kdump-initrd-<ARCH>.img,
              built by make_rootfs.sh on first use.
  -n          Print the vng command line and exit; touches nothing.
  -h          Show this help and exit.

Use -- to separate extra vng arguments; everything after it is passed
straight through to vng untouched.

Examples:
  ${0##*/} -d ufs                 # boot host kernel with a UFS device
  ${0##*/} -a arm64 -d usb-storage
  ${0##*/} -r ~/linux/stable-linux/build-x86_64 -d ufs   # an out-of-tree build dir
  ${0##*/} -a arm64 -r ~/linux/stable-linux/build-arm64 -k -d usb-storage
EOF
}

# devargs DEVICE IMG: the QEMU options for a storage device backed by IMG.
function devargs() {
    case $1 in
        usb-storage)
            echo "-drive if=none,id=usbstick,format=raw,file=$2 -usb -device usb-ehci,id=ehci -device usb-storage,bus=ehci.0,drive=usbstick" ;;
        ufs)
            echo "-drive if=none,id=ufslu0,format=raw,file=$2 -device ufs,id=ufs0,nutrs=32,nutmrs=8 -device ufs-lu,drive=ufslu0,bus=ufs0" ;;
        *) die "Invalid device option $1" ;;
    esac
}

OPT=()
QEMU_OPTS=
BOOTARGS=
ARCH=
KDIR=.
DEVICES=()
DRYRUN=
while getopts ":hkna:r:d:" opt
do
    case $opt in
        h)
            usage
            exit 0
        ;;
        a)
            ARCH=$OPTARG
        ;;
        r)
            KDIR=$OPTARG
        ;;
        d)
            DEVICES+=("$OPTARG")
        ;;
        k)
            KDUMP=1
        ;;
        n)
            DRYRUN=1
        ;;
        \?)
            echo "Unknown option: -$OPTARG" >&2
            usage >&2
            exit 1
        ;;
        :)
            echo "Option -$OPTARG requires an argument" >&2
            usage >&2
            exit 1
        ;;
    esac
done
shift $((OPTIND - 1))

KDIR=$(realpath "$KDIR") || exit 1
OPT+=(-r "$KDIR")

# Disk images live next to the kernel in KDIR.
for dev in "${DEVICES[@]}"; do
    img=$KDIR/${dev%%-*}.img                 # usb.img / ufs.img
    QEMU_OPTS+=" $(devargs "$dev" "$img")" || exit 1
    if [[ -z $DRYRUN && ! -f $img ]]; then
        dd if=/dev/zero of="$img" bs=1k count=1024 status=none && mkfs -t ext4 -q "$img" || exit 1
    fi
done

# The guest images, from make_rootfs.sh: a rootfs for a cross arch (empty
# line for the host's own arch) and the kdump initrd, both kept in step with
# the kernel in KDIR. -n only asks where they would be.
if [[ -n $ARCH || -n $KDUMP ]]; then
    MODE=ensure; [[ -n $DRYRUN ]] && MODE=paths
    { read -r ROOTFS; read -r INITRD; } < <("$SCRIPT_DIR/make_rootfs.sh" $MODE "${ARCH:-x86_64}" "$KDIR") || exit 1
    [[ -n $INITRD ]] || die "make_rootfs.sh failed"
fi

if [[ -n $ARCH ]]; then
    OPT+=(--arch "$ARCH")
    # vng needs a foreign --root for a cross arch unless one was given.
    if [[ -n $ROOTFS && " $* " != *" --root "* ]]; then
        OPT+=(--root "$ROOTFS")
    fi
    # A cross arch runs under TCG; vng's default of one vCPU per host core
    # only slows boot down there. Override with --cpus N after --.
    if [[ " $* " != *" --cpus "* ]]; then
        OPT+=(--cpus 4)
    fi
fi

if [[ -n $KDUMP ]]; then
    KIMG=$KDIR/$(arch_name kimg "${ARCH:-x86_64}") || exit 1
    # kexec -p reads the whole Image into memory and the capture kernel has
    # to boot inside crashkernel=; a debug (KASAN) Image is ~150M, so both
    # the guest and the reservation need room. Override with --memory after --.
    BOOTARGS+="crashkernel=512M kdump_kernel=$KIMG kdump_initrd=$INITRD"
    QEMU_OPTS+=" -device vmcoreinfo"
    if [[ " $* " != *" --memory "* ]]; then
        OPT+=(--memory 4G)
    fi
    GUEST_SHELL=$SCRIPT_DIR/kdump-shell.sh
    # A cross-arch guest boots its own --root and cannot see the host: share
    # what kdump-shell.sh needs (kexec itself comes from the rootfs).
    if [[ -n $ROOTFS ]]; then
        OPT+=("--rodir=$SCRIPT_DIR=$SCRIPT_DIR" "--rodir=$KDIR=$KDIR")
    fi
fi

# Use the locally built QEMU under install_<arch>/ if present, otherwise fall
# back to the system QEMU that vng picks by default.
QEMU_BIN="$SCRIPT_DIR/install_${ARCH:-x86_64}/bin/qemu-system-$(arch_name qemu "${ARCH:-x86_64}")" || exit 1
if [[ -x $QEMU_BIN ]]; then
    log "Using local QEMU: $QEMU_BIN"
    OPT+=(--qemu "$QEMU_BIN")
fi

# vng splits these strings itself; the = form keeps a leading "-device"
# from being taken for an option.
if [[ -n $BOOTARGS ]]; then
    OPT+=("--append=$BOOTARGS")
fi

if [[ -n $QEMU_OPTS ]]; then
    OPT+=("-o=$QEMU_OPTS")
fi

# Run vng with bash shell by default, just for faster booting
OPT+=(--shell "${GUEST_SHELL:-/bin/bash}")

# Show the kernel boot log (loglevel=7); vng hides it behind quiet/loglevel=1
# otherwise. Pass --quiet after -- to override.
if [[ " $* " != *" --quiet "* ]]; then
    OPT+=(--verbose)
fi

if [[ -n $DRYRUN ]]; then
    printf '%q ' vng "${OPT[@]}" "$@"; echo
    exit 0
fi
log "Running: $(printf '%q ' vng "${OPT[@]}" "$@")"
exec vng "${OPT[@]}" "$@"
