#!/usr/bin/env bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

USBIMG=usb.img
UFSIMG=ufs.img

# Bootable kernel image inside a kernel tree, per vng --arch (vng's kimg_path).
function kimg_path() {
    case $1 in
        arm64)     echo arch/arm64/boot/Image ;;
        riscv64)   echo arch/riscv/boot/Image ;;
        ""|x86_64) echo arch/x86/boot/bzImage ;;
        *)         echo "no kernel image path known for arch $1" >&2; exit 1 ;;
    esac
}

# Map a vng --arch value to the QEMU system binary suffix.
function qemu_suffix() {
    case $1 in
        arm64)   echo aarch64 ;;
        armhf)   echo arm     ;;
        ppc64el) echo ppc64    ;;
        ""|x86_64) echo x86_64 ;;
        *)       echo "$1"    ;;   # s390x, riscv64, ... match directly
    esac
}

function usage() {
    cat <<EOF
Usage: ${0##*/} [-h] [-a ARCH] [-r KDIR] [-d DEVICE] [-k] [-- VNG_ARGS...]

Thin wrapper around vng (virtme-ng) that attaches extra QEMU devices and
auto-selects the locally built QEMU under install_<arch>/bin if present.

Options:
  -a ARCH     Target architecture passed to vng --arch (e.g. arm64, riscv64).
              Also selects install_<arch>/bin/qemu-system-<arch> when available
              and defaults --root to <arch>-rootfs/ next to this script.
  -r KDIR     Kernel tree or O= build dir to boot (default: the cwd).
  -d DEVICE   Attach a storage device. Supported:
                usb-storage   USB EHCI stick backed by $USBIMG
                ufs           UFS host controller + LU backed by $UFSIMG
              (disk images are auto-created with ext4 on first use)
  -k          Enable kdump testing: crashkernel=512M, 4G guest, vmcoreinfo, and
              kexec -p the booted kernel as dump-capture kernel at shell start
              (see kdump-shell.sh). Its initrd is kdump-initrd-<ARCH>.img in
              KDIR, built by make_rootfs.sh on first use.
  -h          Show this help and exit.

Use -- to separate extra vng arguments; everything after it is passed
straight through to vng untouched.

Examples:
  ${0##*/} -d ufs                 # boot host kernel with a UFS device
  ${0##*/} -a arm64 -d usb-storage
  ${0##*/} -r ~/linux/stable-linux/build-x86_64 -d ufs   # an out-of-tree build dir
  ${0##*/} -a arm64 -r ~/linux/stable-linux/build-arm64 -k -d usb-storage
EOF
}

function devargs() {
    D=$1
    ARGS=
    case $D in
        "usb-storage")
            if [ ! -f $USBIMG ]; then
                dd if=/dev/zero of=$USBIMG bs=1k count=1024 >&2
                mkfs -t ext4 $USBIMG >&2
            fi
            ARGS="-drive if=none,id=usbstick,format=raw,file=$USBIMG \
                  -usb                                               \
                  -device usb-ehci,id=ehci                           \
                  -device usb-storage,bus=ehci.0,drive=usbstick"
         ;;
        "ufs")
            if [ ! -f $UFSIMG ]; then
                dd if=/dev/zero of=$UFSIMG bs=1k count=1024 >&2
                mkfs -t ext4 $UFSIMG >&2
            fi
            ARGS="-drive if=none,id=ufslu0,format=raw,file=$UFSIMG \
                  -device ufs,id=ufs0,nutrs=32,nutmrs=8            \
                  -device ufs-lu,drive=ufslu0,bus=ufs0"
         ;;
    esac

    echo $ARGS
}

OPT=()
QEMU_OPTS=
BOOTARGS=
ARCH=
KDIR=.
while getopts ":hka:r:d:" opt
do
    case $opt in
        h)
            usage
            exit 0
        ;;
        a)
            ARCH=$OPTARG
        ;;
        r)
            KDIR=$OPTARG
        ;;
        d)
            args=`devargs $OPTARG`
            if [ -z "$args" ]; then
                echo "Invalid device option $OPTARG"
                exit 1
            fi
            QEMU_OPTS+=$args
        ;;
        k)
            KDUMP=1
        ;;
        \?)
            echo "Unknown option: -$OPTARG" >&2
            usage >&2
            exit 1
        ;;
        :)
            echo "Option -$OPTARG requires an argument" >&2
            usage >&2
            exit 1
        ;;
    esac
done
shift $((OPTIND - 1))

KDIR=$(realpath "$KDIR") || exit 1
OPT+=(-r "$KDIR")

if [[ -n $ARCH ]]; then
    OPT+=(--arch "$ARCH")
    # vng needs a foreign --root for a cross arch; default to the rootfs that
    # make_rootfs.sh builds next to this script unless one was given.
    ROOTFS="$SCRIPT_DIR/$ARCH-rootfs"
    if [[ -d $ROOTFS && " $* " != *" --root "* ]]; then
        OPT+=(--root "$ROOTFS")
    fi
    # A cross arch runs under TCG; vng's default of one vCPU per host core
    # only slows boot down there. Override with --cpus N after --.
    if [[ " $* " != *" --cpus "* ]]; then
        OPT+=(--cpus 4)
    fi
fi

# kdump: the capture-kernel initrd lives next to the kernel image in KDIR
# and is built on first use.
if [[ -n $KDUMP ]]; then
    KIMG=$KDIR/$(kimg_path "$ARCH") || exit 1
    INITRD=$KDIR/kdump-initrd-${ARCH:-x86_64}.img
    if [[ ! -f $INITRD ]]; then
        OUT=$INITRD "$SCRIPT_DIR/make_rootfs.sh" "${ARCH:-x86_64}" initrd || exit 1
    fi
    # kexec -p reads the whole Image into memory and the capture kernel has
    # to boot inside crashkernel=; a debug (KASAN) Image is ~150M, so both
    # the guest and the reservation need room. Override with --memory after --.
    BOOTARGS+="crashkernel=512M kdump_kernel=$KIMG kdump_initrd=$INITRD"
    QEMU_OPTS+=" -device vmcoreinfo"
    if [[ " $* " != *" --memory "* ]]; then
        OPT+=(--memory 4G)
    fi
    GUEST_SHELL=$SCRIPT_DIR/kdump-shell.sh
    # A cross-arch guest boots its own --root and cannot see the host: share
    # what kdump-shell.sh needs (kexec itself comes from the rootfs).
    if [[ -n $ARCH ]]; then
        OPT+=("--rodir=$SCRIPT_DIR=$SCRIPT_DIR" "--rodir=$KDIR=$KDIR")
    fi
fi

# Use the locally built QEMU under install_<arch>/ if present, otherwise fall
# back to the system QEMU that vng picks by default.
QEMU_ARCH="$(qemu_suffix "$ARCH")"
QEMU_BIN="$SCRIPT_DIR/install_$QEMU_ARCH/bin/qemu-system-$QEMU_ARCH"
if [[ -x $QEMU_BIN ]]; then
    echo "Using local QEMU: $QEMU_BIN"
    OPT+=(--qemu "$QEMU_BIN")
fi

# vng splits these strings itself; the = form keeps a leading "-device"
# from being taken for an option.
if [[ -n $BOOTARGS ]]; then
    OPT+=("--append=$BOOTARGS")
fi

if [[ -n $QEMU_OPTS ]]; then
    OPT+=("-o=$QEMU_OPTS")
fi

# Run vng with bash shell by default, just for faster booting
OPT+=(--shell "${GUEST_SHELL:-/bin/bash}")

# Show the kernel boot log (loglevel=7); vng hides it behind quiet/loglevel=1
# otherwise. Pass --quiet after -- to override.
if [[ " $* " != *" --quiet "* ]]; then
    OPT+=(--verbose)
fi

echo "Running: $(printf '%q ' vng "${OPT[@]}" "$@")"
exec vng "${OPT[@]}" "$@"
